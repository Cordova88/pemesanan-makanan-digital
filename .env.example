# Contoh tanpa rahasia. Profil lokal default tidak memerlukan file ini.
# Profil settings dapat memuat .env lokal jika python-dotenv terpasang.
# Isi secret acak khusus server (minimal 50 karakter) melalui pengaturan hosting.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
SQLITE_DATABASE_NAME=db.sqlite3
CHATBOT_REDIS_URL=

# Gemini adalah satu-satunya sumber balasan chatbot. Aktifkan dengan kunci API.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOOL_ITERATIONS=4
