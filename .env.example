# Contoh tanpa rahasia. Profil lokal default tidak memerlukan file ini.
# Profil settings dapat memuat .env lokal jika python-dotenv terpasang.
# Isi secret acak khusus server (minimal 50 karakter) melalui pengaturan hosting.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
SQLITE_DATABASE_NAME=db.sqlite3
CHATBOT_REDIS_URL=

# Gemini tetap nonaktif. Model dan key disiapkan pemilik akun bila diperlukan.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOOL_ITERATIONS=4
# Jalur di bawah untuk fallback/komponen hybrid lama, bukan pemilih mode AI-first.
CHATBOT_AI_RESPONSE_MODE=ranking
CHATBOT_AI_WORDING_ENABLED=false
CHATBOT_PROPOSAL_V3_ENABLED=false
